// Build-time configuration (public identifiers and URLs, not credentials).
// Override on the xcodebuild command line, for example:
//   xcodebuild ... MAPROULETTE_BASE_URL=https://mr-dev.osm.lol
// `$()` keeps `//` from starting a comment.

// The mobile-enabled MapRoulette API origin. mr-api.osm.lol is the dev deployment (development
// OSM); it is planned to be renamed to mr-dev.osm.lol.
MAPROULETTE_BASE_URL = https:/$()/mr-api.osm.lol
// The native OAuth client registered on that backend, and the scheme of its callback
// (<scheme>:/oauth2redirect). Registered on dev (mr-api.osm.lol); stage/prod need the same client.
MAPROULETTE_OAUTH_CLIENT_ID = maproulette-ios-choice
MAPROULETTE_OAUTH_CALLBACK_SCHEME = lol.osm.maproulette.choice
MAPROULETTE_ALLOW_LOOPBACK = NO
// YES lets the stage and prod backends (mr-stage/mr-prod.osm.lol, which edit the real
// OpenStreetMap) receive answers. Off until the pilot moves there.
MAPROULETTE_ALLOW_LIVE_WRITES = NO
// YES: participants answer first and put their answers on the map later (deferred sign-up).
// Needs a backend with mobileOAuth.guests.enabled.
MAPROULETTE_GUESTS = NO
// The OpenFreeMap (or any MapLibre) style for the task map.
MAP_STYLE_URL = https:/$()/tiles.openfreemap.org/styles/positron
// The small map above a task.
MAP_DETAIL_STYLE_URL = https:/$()/tiles.openfreemap.org/styles/liberty

// The participant web host: campaign links and QR codes (https://<host>/challenge/<id>) open the
// app through universal links once it serves apple-app-site-association; otherwise its landing
// page. Sets the Associated Domains entitlement (applinks:<host>).
CAMPAIGN_LINK_HOST = streettally.osm.lol

APP_BUNDLE_IDENTIFIER = lol.osm.maproulette.choice

// Asset catalog (MapRouletteChoice/Assets.xcassets): the Street Tally icon (A, tally gate, with
// dark and tinted variants) and the brand colors. AccentColor is the text-safe amber, so it is
// also the app's tint.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
