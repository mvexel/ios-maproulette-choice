// Build-time configuration (public identifiers and URLs, not credentials).
// Override on the xcodebuild command line, for example:
//   xcodebuild ... MAPROULETTE_BASE_URL=https://mr-dev.osm.lol
// `$()` keeps `//` from starting a comment.

// The mobile-enabled MapRoulette API origin. mr-api.osm.lol is the dev deployment (development
// OSM); it is planned to be renamed to mr-dev.osm.lol.
MAPROULETTE_BASE_URL = https:/$()/mr-api.osm.lol
// A native client registered on that backend with callback org.maproulette.example:/oauth2redirect.
// The SDK example's client works until this app has its own registration.
MAPROULETTE_OAUTH_CLIENT_ID = maproulette-ios-example
MAPROULETTE_ALLOW_LOOPBACK = NO
// The OpenFreeMap (or any MapLibre) style for the task map.
MAP_STYLE_URL = https:/$()/tiles.openfreemap.org/styles/liberty

APP_BUNDLE_IDENTIFIER = lol.osm.maproulette.choice
