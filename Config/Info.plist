<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<key>MRBaseURL</key>
	<string>$(MAPROULETTE_BASE_URL)</string>
	<key>MROAuthClientID</key>
	<string>$(MAPROULETTE_OAUTH_CLIENT_ID)</string>
	<key>MROAuthCallbackScheme</key>
	<string>$(MAPROULETTE_OAUTH_CALLBACK_SCHEME)</string>
	<key>MRAllowLoopback</key>
	<string>$(MAPROULETTE_ALLOW_LOOPBACK)</string>
	<key>MRAllowLiveWrites</key>
	<string>$(MAPROULETTE_ALLOW_LIVE_WRITES)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).campaign</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mrchoice</string>
			</array>
		</dict>
	</array>
	<key>MRCampaignLinkHost</key>
	<string>$(CAMPAIGN_LINK_HOST)</string>
	<key>MRMapDetailStyleURL</key>
	<string>$(MAP_DETAIL_STYLE_URL)</string>
	<key>MRGuests</key>
	<string>$(MAPROULETTE_GUESTS)</string>
	<key>MRMapStyleURL</key>
	<string>$(MAP_STYLE_URL)</string>
</dict>
</plist>
